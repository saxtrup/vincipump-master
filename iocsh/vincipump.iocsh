# ---

epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(vincipump_DIR)db/")

drvAsynIPPortConfigure("Bck", "$(IP_ADDRESS)", 0, 0, 1)

modbusInterposeConfig("Bck", 0, 1000, 0)

drvModbusAsynConfigure(FC3A, Bck, 0, 3, 0, 52, 0, 1000, "");
drvModbusAsynConfigure(FC16A, Bck, 0, 16, 0, 52, 0, 1000, "");
drvModbusAsynConfigure(FC6A,Bck, 0, 6, 0, 52, 0, 1000, "");
drvModbusAsynConfigure(FC5 , Bck, 0, 5, 0, 76, 0, 1000, "");
drvModbusAsynConfigure(FC5A, Bck, 0, 5, 16, 16, 0, 1000, "");
drvModbusAsynConfigure(FC2 , Bck, 0, 2, 0, 76, 0, 1000, "");
drvModbusAsynConfigure(FC2A, Bck, 0, 2, 16, 16, 0, 1000, "");

dbLoadRecords("$(vincipump_DIR)/db/vinci_word_drives.template", "P=$(P), R=$(R), FC6=FC6A, FC3=FC3A, FC16=FC16A")
dbLoadRecords("$(vincipump_DIR)/db/vinci_bits.template", "P=$(P), R=$(R)")
dbLoadRecords("$(vincipump_DIR)/db/vinci_bits_drives.template", "P=$(P), R=$(R), FC2=FC2A, FC5=FC5A")
dbLoadRecords("$(vincipump_DIR)/db/vinci_calc.template", "P=$(P), R=$(R)")
dbLoadRecords("$(vincipump_DIR)/db/vinci_heartbeat.template", "P=$(P), R=$(R)")
