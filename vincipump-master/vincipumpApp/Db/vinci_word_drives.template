record(mbbi, "$(P)$(R)PumpMode-RB") {
   field(DTYP, "asynInt32")
   field(INP, "@asyn($(FC3), 16, 1000)INT16")
   field(SCAN, "1 second")
   field(DESC, "Pump Mode RBV")
   field(ZRVL, "1")
   field(ONVL, "2")
   field(TWVL, "6")
   field(THVL, "7")
   field(FRVL, "8")
   field(FVVL, "9")
   field(SXVL, "11")
   field(SVVL, "13")
   field(ZRST, "Pressure")
   field(ONST, "Flow")
   field(TWST, "Fill")
   field(THST, "Empty")
   field(FRST, "Double pressure")
   field(FVST, "Double flow")
   field(SXST, "Confining")
   field(SVST, "Triple process")
}

record(mbbo, "$(P)$(R)PumpMode-S") {
   field(DTYP, "asynInt32")
