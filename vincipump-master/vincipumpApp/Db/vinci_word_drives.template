# Read/write the WORD registers from the device
record(ai, "$(P)$(R)Volume-R") {
    field(DTYP, "asynFloat64")
    field(INP, "@asyn($(FC3), 4, 1000)FLOAT32_LE")
    field(SCAN, "1 second")
    field(EGU, "cc")
    field(DESC, "Volume")
}

